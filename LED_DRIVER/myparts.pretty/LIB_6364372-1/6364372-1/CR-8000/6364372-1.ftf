            (circle 119000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c350))
          (noconnect (pad c350))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c350))
          (noconnect (pad c350))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c350))
          (noconnect (pad c350))
        )
        (padSet (footLayer Inner)
          (clearance (pad c350))
          (connect (pad c350))
          (noconnect (pad c350))
        )
        (padSet (footLayer Bottom)
          (connect (pad c350))
          (noconnect (pad c350))
        )
      )
    ); End of padstacks
    (footprints
